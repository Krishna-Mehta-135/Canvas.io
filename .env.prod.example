# ─────────────────────────────────────────────────────────────────────────────
# .env.prod.example — CanvasSync production environment (GCP 3-VM cluster)
#
# Copy this to .env on each VM (or inject as GitHub Actions secrets at deploy).
#
# VM topology:
#   VM 1 & VM 2 (e2-small) → run: http-backend, ws-backend
#   Worker VM   (e2-micro)  → run: rabbitmq, ai-worker
#
# Managed services:
#   - Database  → GCP Cloud SQL (postgres 15)
#   - Cache     → GCP Memorystore for Redis (shared; Canvas isolated via "canvas:" keyPrefix)
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
INTERNAL_SECRET=replace-with-output-of-openssl-rand-hex-32

# ── Database (GCP Cloud SQL — private IP) ─────────────────────────────────────
DATABASE_URL=postgresql://canvas:REPLACE_STRONG_PASSWORD@CLOUD_SQL_PRIVATE_IP:5432/canvas_db

# ── Redis (GCP Memorystore — private IP) ──────────────────────────────────────
# Canvas uses keyPrefix "canvas:" in ioredis, so all keys are namespace-isolated.
REDIS_URL=redis://MEMORYSTORE_PRIVATE_IP:6379

# ── RabbitMQ (running as container on Worker VM — internal private IP) ─────────
# On the App VMs (VM 1 & VM 2) use the Worker VM's private IP:
RABBITMQ_URL=amqp://canvas:RABBITMQ_PASS@WORKER_VM_PRIVATE_IP:5672
# On the Worker VM itself, the ai-worker references the sibling container:
# RABBITMQ_URL is constructed from RABBITMQ_USER + RABBITMQ_PASS in docker-compose.prod.yml

# RabbitMQ container credentials (Worker VM only)
RABBITMQ_USER=canvas
RABBITMQ_PASS=replace-with-a-strong-rabbitmq-password

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
WEB_APP_URL=https://canvassync.tech

# ── Email ─────────────────────────────────────────────────────────────────────
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
GMAIL_FROM_EMAIL=Canvas.io <your-email@gmail.com>

# ── HTTP rate limiting ────────────────────────────────────────────────────────
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX_REQUESTS=120

# ── DB Resilience ─────────────────────────────────────────────────────────────
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=75
DB_CIRCUIT_BREAKER_ENABLED=true
DB_CIRCUIT_FAILURE_THRESHOLD=5
DB_CIRCUIT_WINDOW_MS=60000
DB_CIRCUIT_OPEN_MS=30000
DB_CIRCUIT_HALF_OPEN_SUCCESS_THRESHOLD=2

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_ENABLE_DURABLE_QUEUE=true
WS_DEBUG_ERRORS=false

# ── AI Generation Queue ───────────────────────────────────────────────────────
RABBITMQ_AI_GENERATE_EXCHANGE=canvas.ai.generate
RABBITMQ_AI_GENERATE_QUEUE=canvas.ai.generate.jobs
RABBITMQ_AI_GENERATE_ROUTING_KEY=ai.generate

# ── AI Provider ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-real-gemini-api-key
GEMINI_MODEL_CANDIDATES=gemini-2.5-flash,gemini-2.5-flash-lite

# ── Worker VM callback URL ────────────────────────────────────────────────────
# ai-worker uses this to POST results back. On the Worker VM, point it at the
# GCP Load Balancer (since App VMs aren't directly reachable from the micro VM).
HTTP_BACKEND_INTERNAL_URL=https://canvassync.tech/api

# ── GHCR image pull (App VMs & Worker VM) ────────────────────────────────────
GITHUB_REPO=your-github-username/canvassync

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.knowdex.me/api/v1/auth/google/callback
GH_CLIENT_ID=your_github_client_id
GH_CLIENT_SECRET=your_github_client_secret
GH_CALLBACK_URL=https://api.knowdex.me/api/v1/auth/github/callback
# list of allowed CORS origins:
ALLOWED_ORIGINS=https://canvassync.tech

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Actions Secrets required for deploy.yml:
#
#   VM_1_IP          — External IP of first e2-small App VM
#   VM_2_IP          — External IP of second e2-small App VM
#   WORKER_VM_IP     — External IP of e2-micro Worker VM
#   VM_USER          — SSH username (e.g. "ubuntu" or "canvasadmin")
#   VM_SSH_KEY       — Private SSH key (PEM format, no passphrase)
#   DATABASE_URL     — Full Cloud SQL connection string
#   REDIS_URL        — redis://MEMORYSTORE_PRIVATE_IP:6379
#   RABBITMQ_URL     — amqp://canvas:PASS@WORKER_VM_PRIVATE_IP:5672
#   RABBITMQ_PASS    — RabbitMQ container password (Worker VM)
#   JWT_SECRET       — Long random hex string
#   INTERNAL_SECRET  — Long random hex string
#   GEMINI_API_KEY   — Google AI Studio API key
#   WEB_APP_URL      — https://canvassync.tech
#   GITHUB_REPO      — your-github-username/canvassync
# ─────────────────────────────────────────────────────────────────────────────