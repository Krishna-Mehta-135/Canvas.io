# Core
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
DATABASE_URL=postgresql://canvas:replace-with-POSTGRES_PASSWORD@postgres:5432/canvas
PORT=3001
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqps://your-cloudamqp-url-goes-here

# Email Config
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
GMAIL_FROM_EMAIL=Canvas.io <your-email@gmail.com>
WEB_APP_URL=https://your-app.vercel.app

# HTTP rate limiting
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX_REQUESTS=120

# DB Resilience
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=75
DB_CIRCUIT_BREAKER_ENABLED=true
DB_CIRCUIT_FAILURE_THRESHOLD=5
DB_CIRCUIT_WINDOW_MS=60000
DB_CIRCUIT_OPEN_MS=30000
DB_CIRCUIT_HALF_OPEN_SUCCESS_THRESHOLD=2

# AI Generation Queue
RABBITMQ_AI_GENERATE_EXCHANGE=canvas.ai.generate
RABBITMQ_AI_GENERATE_QUEUE=canvas.ai.generate.jobs
RABBITMQ_AI_GENERATE_ROUTING_KEY=ai.generate

# AI provider
GEMINI_API_KEY=your-real-gemini-api-key
GEMINI_MODEL_CANDIDATES=gemini-2.5-flash,gemini-2.5-flash-lite

# Internal worker callback security
INTERNAL_SECRET=replace-with-output-of-openssl-rand-hex-32
HTTP_BACKEND_INTERNAL_URL=http://http-backend:3001

# Postgres container password (used above in DATABASE_URL)
POSTGRES_PASSWORD=replace-with-a-strong-password

# GitHub repo for pulling Docker images (username/reponame)
GITHUB_REPO=your-github-username/your-repo-name

#OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:8000/api/v1/auth/google/callback"
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:8000/api/v1/auth/github/callback"