{
  "name": "canvas-io",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "ci": "pnpm run lint && pnpm run check-types && pnpm run test",
    "db:up": "cd packages/db && docker-compose up -d",
    "db:down": "cd packages/db && docker-compose down",
    "db:logs": "cd packages/db && docker-compose logs -f"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  }
}
